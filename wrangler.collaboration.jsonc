// Local/emulated ONLY. No Artifacts binding: do not contact a real namespace. Review placeholder IDs before any approved activation.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "together-collaboration-local",
  "main": "cloud/remote-entry.ts",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DIRECTORY_OBJECT",
        "class_name": "DirectoryObject"
      },
      {
        "name": "SESSION_OBJECT",
        "class_name": "SessionObject"
      },
      {
        "name": "PROJECT_OBJECT",
        "class_name": "ProjectObject"
      },
      {
        "name": "EXECUTION_OBJECT",
        "class_name": "ExecutionObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DirectoryObject",
        "SessionObject",
        "ProjectObject",
        "ExecutionObject"
      ]
    }
  ],
  "vars": {
    "TEST_REPO_PREFIX": "together-cloud-",
    "TEST_CANONICAL_REF": "refs/heads/together-cloud",
    "ALLOWED_ORIGINS": "",
    "TOGETHER_REMOTE_MCP_ENABLED": "false",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8791"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_INGRESS_LIMITER",
      "namespace_id": "1001001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "MCP_PRINCIPAL_LIMITER",
      "namespace_id": "1001002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
