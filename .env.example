# Private server configuration; copy to .env (gitignored).
# Choose ONE existing Nebius credential route. Never place keys in browser code.
# NEBIUS_API_KEY=your-key
# NEBIUS_API_KEY_FILE=/absolute/private/path/to/nebius-key.txt
# Optional loopback ports (0 selects free ports) and durable state:
# TOGETHER_DEMO_PORT=0
# TOGETHER_DEMO_API_PORT=0
# TOGETHER_STATE_DIR=/absolute/owned/state
